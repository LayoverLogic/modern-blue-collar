# =============================================================================
# Modern Blue Collar — environment configuration (used by docker-compose.yml)
#
#   LOCAL DEMO:  cp .env.example .env && docker compose --profile demo up --build
#                The values below already point at the bundled MinIO + Mailpit +
#                Postgres, so the demo works with NO changes.
#
#   PRODUCTION:  one VPS per client — use deploy/provision.sh with
#                deploy/clients/example.env.example (DEPLOYMENT.md). To run this
#                compose file live instead: DEMO_MODE=false, NODE_ENV=production,
#                set JWT_SECRET, point DATABASE_URL / S3 / BACKUP_S3 / SMTP at your
#                real services (any S3-compatible storage, e.g. Cloudflare R2 or
#                Backblaze B2), fill in the Google / QuickBooks / Twilio creds you
#                use, then:  docker compose up -d --build   (note: NO --profile demo)
# =============================================================================

# ─── Demo switch ─────────────────────────────────────────────────────────────
# true  → local email/password auth (seeded admin), Twilio + QuickBooks no-op,
#         storage → MinIO, email → Mailpit.
# false → full production behavior (real integrations per the vars below).
DEMO_MODE=true

# ─── Postgres (the `postgres` compose service) ───────────────────────────────
POSTGRES_USER=mbc
POSTGRES_PASSWORD=mbc_demo_password
POSTGRES_DB=mbc
POSTGRES_PORT=5432
# App DB connection. Host = the compose service name `postgres`.
# PRODUCTION: replace with your managed DB URL (often needs ?sslmode=require).
DATABASE_URL=postgresql://mbc:mbc_demo_password@postgres:5432/mbc?schema=public

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=http://localhost:3001
# Demo MUST use 'development': the server refuses DEMO_MODE=true with
# NODE_ENV=production. Use 'production' (and DEMO_MODE=false) live.
NODE_ENV=development
# Leave blank for the local demo: the server then uses a random per-boot secret
# (sessions end when the container restarts). PRODUCTION: set 32+ random chars —
# the server refuses to start with NODE_ENV=production otherwise. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# Seeded demo admin (created on boot when DEMO_MODE=true). CHANGE FOR PRODUCTION.
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD=demo1234
ADMIN_FIRST=Demo
ADMIN_LAST=Admin
# Password assigned to seeded demo team members (seed_jobs.js)
DEFAULT_PASSWORD=demo1234

# ─── Object storage for job photos (AWS S3 SDK) ──────────────────────────────
# DEMO: the bundled MinIO service. PRODUCTION: any S3-compatible bucket
# (Cloudflare R2, Backblaze B2, AWS S3) — change endpoint + keys only.
# Keep photos and backups in separate buckets with separate tokens.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mbc-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# MinIO root credentials (demo service). Keep in sync with S3_ACCESS/SECRET above.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Email / SMTP ────────────────────────────────────────────────────────────
# DEMO: the bundled Mailpit catch-all (web UI at http://localhost:8025).
# PRODUCTION: your real SMTP host/port/user/pass.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@demo.test
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Branding / white-label (see brand.config.js, SETUP.md "White-label") ─────
# Env-only: switching client or trade never needs a source edit. Invalid values
# (unknown trade, bad colour, bad URL, unknown time zone) stop the server at
# boot with a message naming the variable.
BRAND_COMPANY_NAME=Modern Blue Collar
BRAND_COMPANY_SLOGAN=Field Service Management
BRAND_COMPANY_PHONE=
BRAND_COMPANY_EMAIL=
BRAND_COMPANY_ADDRESS=
# electrical | plumbing | hvac | plumbing-hvac | contracting  (case-insensitive;
# "Plumbing & HVAC", "HVAC", "General Contracting" are accepted too)
BRAND_TRADE_TYPE=plumbing-hvac
# Labels — blank = derived from the trade (Electrician / Plumber / HVAC Technician ...)
BRAND_TECH_LABEL=
BRAND_INDUSTRY_LABEL=
# Colours: hex, quoted so # is not a comment. Blank = the trade's palette
# (electrical yellow, plumbing blue, hvac teal, plumbing-hvac blue, contracting
# orange). PRIMARY_DARK (hover/active) and readable text colours are derived from
# PRIMARY / NAV_BG / HEADER_BG unless set.
BRAND_COLOR_PRIMARY=
BRAND_COLOR_PRIMARY_DARK=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
BRAND_COLOR_NAV_BG=
BRAND_COLOR_NAV_TEXT=
BRAND_COLOR_HEADER_BG=
BRAND_COLOR_HEADER_TEXT=
# Logo / favicon: https:// URL, a same-origin path (/brand/logo.svg) or a
# data:image/...;base64 URL. Favicon defaults to the logo.
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
# Default state for US address forms; IANA time zone for dates, "today", backups
BRAND_DEFAULT_STATE=KS
BRAND_TIMEZONE=America/Chicago
# Locale: US (default) | IE — currency, tax, address rules, E.164 phone
# normalisation, week start. Uncomment to override; an EMPTY BRAND_TAX_RATES /
# BRAND_*_PREFIX means "none", so leave those commented unless you set them.
BRAND_COUNTRY=
# BRAND_CURRENCY=EUR
# BRAND_TAX_RATES=standard:23,reduced:13.5,zero:0
# BRAND_TAX_DEFAULT=reduced
# BRAND_TAX_LABEL=VAT
# BRAND_TAX_NUMBER=
# BRAND_QUOTE_PREFIX=Q-
# BRAND_INVOICE_PREFIX=INV-
# BRAND_RCT_NOTE=
# Technicians: own (default) = see only their own jobs; all = read the whole
# schedule / every job and customer, still edit only their own jobs.
TECH_VISIBILITY=own
# Demo data prospect: backend/demo/prospects/<slug>.json (blank = "default",
# a generic Anytown demo for whatever BRAND_TRADE_TYPE is). Per-prospect env file:
#   node scripts/seed-demo.js --prospect ks-plumbing-example --print-env
DEMO_PROSPECT=

# =============================================================================
# PRODUCTION integrations — left blank/dormant in demo. Fill in + DEMO_MODE=false
# to go live. See SETUP.md / DEPLOYMENT.md for how to obtain each credential.
# =============================================================================

# Off-site backups (S3-compatible; backup.js, DEPLOYMENT.md). In the demo they
# point at the bundled MinIO so the nightly backup works locally. PRODUCTION: a
# bucket used ONLY for backups (Cloudflare R2, Backblaze B2, AWS S3) with a
# token scoped to it. A failed upload fails the backup.
# Legacy: the old WASABI_* names are still read as a per-variable fallback for
# BACKUP_S3_* — new installs use the names below.
# local | s3 — blank: s3 when bucket + keys are set (as here), else local
BACKUP_DRIVER=
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=mbc-backups
BACKUP_S3_ACCESS_KEY=minioadmin
BACKUP_S3_SECRET_KEY=minioadmin
BACKUP_S3_PREFIX=backups/
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_MULTIPART_MB=100
# Optional: AES-256-GCM encryption of dumps + photo archives. Keep a copy of the
# key OFF the server — without it the backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Optional: Healthchecks.io-style ping after each backup (failures → FAIL_URL,
# or <url>/fail for hc-ping.com)
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
# Local copies kept (sets / sets that keep their photo archive)
BACKUP_KEEP=30
BACKUP_KEEP_UPLOADS=3

# Google OAuth (optional team SSO). Blank → "Continue with Google" hidden in demo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# QuickBooks Online. Blank / DEMO_MODE → "Connect" shown but live auth disabled.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENVIRONMENT=sandbox

# Twilio SMS. Blank / DEMO_MODE → outbound SMS is logged to console, not sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=
