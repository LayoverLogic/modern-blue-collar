# ─── Demo mode ────────────────────────────────────────────────────────────────
# true → local email/password auth (seeded admin), Twilio + QuickBooks no-op,
#        storage → MinIO, email → Mailpit. Leave false/unset for production.
# NOTE: for the Docker demo the authoritative template is the repo-root
# .env.example (consumed by docker-compose.yml). This file is for running the
# backend directly (npm run dev).
DEMO_MODE=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production: the Postgres container from deploy/docker-compose.prod.yml,
# or any managed PostgreSQL 16)
DATABASE_URL="postgresql://user:password@host:25060/dbname?sslmode=require"
# SQLite (local dev only — uncomment below, comment out PostgreSQL above)
# DATABASE_URL="file:./dev.db"

# ─── Google OAuth (console.cloud.google.com) ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: at least 32 random characters. The server refuses to
# start with NODE_ENV=production if this is missing, short, or a published
# example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Email / SMTP (team-invite emails) ────────────────────────────────────────
# Standard SMTP. For local testing point at Mailpit: host=localhost port=1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@yourdomain.com

# ─── QuickBooks Online (developer.intuit.com) ─────────────────────────────────
QB_CLIENT_ID=your_qb_client_id
QB_CLIENT_SECRET=your_qb_client_secret
QB_REDIRECT_URI=https://yourdomain.com/api/quickbooks/callback
QB_ENVIRONMENT=sandbox

# ─── Twilio SMS (twilio.com/console) ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000

# ─── Google Maps (console.cloud.google.com) ───────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Off-site backups (S3-compatible; backup.js, DEPLOYMENT.md) ─────────────
# Nightly at 03:00 (BRAND_TIMEZONE): pg_dump + the local photo folder, written
# to BACKUP_DIR, then uploaded when BACKUP_DRIVER=s3. Any S3-compatible bucket
# works (Cloudflare R2, Backblaze B2, AWS S3, MinIO). Use a bucket used ONLY
# for backups, with a token scoped to it. A failed upload fails the backup.
#   BACKUP_DRIVER  local | s3   (unset: s3 when bucket + keys are set, else local)
# Legacy: the old WASABI_* names (WASABI_BUCKET, WASABI_ACCESS_KEY, ...) are
# still read as a per-variable fallback for BACKUP_S3_*. Use the names below.
BACKUP_DRIVER=
BACKUP_S3_ENDPOINT=
# `auto` for R2, the bucket's region otherwise
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Key prefix inside the bucket (default backups/)
BACKUP_S3_PREFIX=backups/
BACKUP_S3_FORCE_PATH_STYLE=true
# Files above this size (MB) use multipart upload (default 100)
BACKUP_S3_MULTIPART_MB=100
# Optional: encrypt dumps + photo archives (AES-256-GCM). KEEP A COPY OF THIS
# KEY OFF THE SERVER — without it the backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Optional monitoring: GET after every successful backup (e.g. a Healthchecks.io
# ping URL); failures are POSTed to BACKUP_HEARTBEAT_FAIL_URL (hc-ping.com URLs
# get <url>/fail automatically).
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
# Local retention: backup sets kept in BACKUP_DIR (default backend/backups), and
# how many of those keep their (large) photo archive
BACKUP_DIR=
BACKUP_KEEP=30
BACKUP_KEEP_UPLOADS=3
# Binaries (default: found on PATH): pg_dump for backups, psql + tar for `npm run restore`
# PG_DUMP_PATH=
# PSQL_PATH=
# TAR_PATH=

# ─── Object storage for job photos (S3-compatible) ────────────────────────────
# Keep photos and backups in SEPARATE buckets with separate tokens. (Legacy:
# the old WASABI_* names are still read when S3_* are unset.) For local
# testing point at MinIO: S3_ENDPOINT=http://localhost:9000, keys=minioadmin.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=mbc-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
APP_URL=https://yourdomain.com
NODE_ENV=production

# ─── Technician visibility (helpers/access.js) ────────────────────────────────
# own (default): technicians see only their own jobs and those jobs' customers.
# all: technicians can READ the whole schedule, every job and customer (not
#      quotes / invoices / communications of other people's jobs); they still
#      only WRITE status / notes / photos on their own jobs.
TECH_VISIBILITY=own

# ─── Branding / white-label (see brand.config.js, SETUP.md "White-label") ─────
# Env-only: switching client or trade never needs a source edit. Invalid values
# (unknown trade, bad colour, bad URL, unknown time zone) stop the server at
# boot with a message naming the variable.
# Real client: set BRAND_COMPANY_* to the client's details.
BRAND_COMPANY_NAME=My Company LLC
BRAND_COMPANY_SLOGAN=Field Service Management
BRAND_COMPANY_PHONE=
BRAND_COMPANY_EMAIL=
BRAND_COMPANY_ADDRESS=
# electrical | plumbing | hvac | plumbing-hvac | contracting  (case-insensitive;
# "Plumbing & HVAC", "HVAC", "General Contracting" are accepted too)
BRAND_TRADE_TYPE=electrical
# Labels — blank = derived from the trade (Electrician / Plumber / HVAC Technician ...)
BRAND_TECH_LABEL=
BRAND_INDUSTRY_LABEL=
# Colours: hex, quoted so # is not a comment. Blank = the trade's palette
# (electrical yellow, plumbing blue, hvac teal, plumbing-hvac blue, contracting
# orange). PRIMARY_DARK (hover/active) and readable text colours are derived from
# PRIMARY / NAV_BG / HEADER_BG unless set.
BRAND_COLOR_PRIMARY=
BRAND_COLOR_PRIMARY_DARK=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
BRAND_COLOR_NAV_BG=
BRAND_COLOR_NAV_TEXT=
BRAND_COLOR_HEADER_BG=
BRAND_COLOR_HEADER_TEXT=
# Logo / favicon: https:// URL, a same-origin path (/brand/logo.svg) or a
# data:image/...;base64 URL. Favicon defaults to the logo.
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
# Default state for US address forms; IANA time zone for dates, "today", backups
BRAND_DEFAULT_STATE=KS
BRAND_TIMEZONE=America/Chicago

# ─── Locale (helpers/locale.js) ───────────────────────────────────────────────
# US (default) | IE. Sets currency, tax, address rules, phone normalisation
# (customer / user phones are stored as E.164, e.g. +16205550142) and the
# first day of the week (US sunday, IE monday). Uncomment to override a default;
# an EMPTY BRAND_TAX_RATES / BRAND_*_PREFIX means "none", so leave them commented.
BRAND_COUNTRY=
# Job types offered on jobs (comma list, ≤ 40, validated at boot). Unset = the
# trade's list in the BRAND_COUNTRY wording (IE: Boiler Service, Consumer Unit Upgrade…).
# BRAND_JOB_TYPES=Boiler Service,Boiler Repair,Leak Repair,Other
# BRAND_CURRENCY=EUR
# BRAND_TAX_RATES=standard:23,reduced:13.5,zero:0
# BRAND_TAX_DEFAULT=reduced
# BRAND_TAX_LABEL=VAT
# BRAND_TAX_NUMBER=
# BRAND_QUOTE_PREFIX=Q-
# BRAND_INVOICE_PREFIX=INV-
# Reverse charge on quotes / invoices: default on for IE (VAT) with tax rates, off for US sales tax
# BRAND_REVERSE_CHARGE=false
# BRAND_RCT_NOTE=

# ─── Accounts & sign-in (Phase 2d / B3) ──────────────────────────────────────
# Only FAILED sign-ins count, per IP + email and per IP (in memory, 15 min).
# LOGIN_MAX_PER_EMAIL=10
# LOGIN_MAX_PER_IP=50
# Forgot / reset / invite-link requests per IP per 15 min
# RESET_RATE_MAX=20
# PASSWORD_MIN_LENGTH=10           (never below 8)
# RESET_TOKEN_TTL_MINUTES=30       forgot-password / admin reset links
# INVITE_TTL_HOURS=168             accept-invite links
# seed_superadmin: a generated password is always temporary; force it for ADMIN_PASSWORD too
# ADMIN_FORCE_PASSWORD_CHANGE=false
