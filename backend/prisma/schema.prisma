generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ──────────────────────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  // roles: super-admin | admin | technician | dispatcher | office
  role      String   @default("technician")
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  jobs      Job[]
  apiKeys   ApiKey[]
}

// ─── Customer ─────────────────────────────────────────────────────────────────
model Customer {
  id             Int             @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String?
  phone          String
  address        String
  // Line 2 (apt / suite / estate). Labels per country: helpers/locale.js
  addressLine2   String?
  // city = US city / IE town; state = US state / IE county; zip = ZIP / Eircode.
  // Nullable since 20261121140000_documents_locale (required fields depend on
  // the locale, see helpers/locale.js). No DB default for state any more — the
  // app applies BRAND_DEFAULT_STATE (US) on create.
  city           String?
  state          String?
  zip            String?
  // ISO 3166-1 alpha-2; null = the brand's country (BRAND_COUNTRY)
  country        String?
  company        String?
  // Customer VAT / tax number (B2B invoices, reverse charge)
  taxNumber      String?
  // type: residential | commercial | industrial
  type           String          @default("residential")
  notes          String?
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  // Import provenance (e.g. "housecallpro" + its id); unique pair, both null for native rows
  sourceSystem   String?
  sourceId       String?
  jobs           Job[]
  communications Communication[]

  @@unique([sourceSystem, sourceId])
}

// ─── Job ──────────────────────────────────────────────────────────────────────
model Job {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  // status: pending | scheduled | in-progress | completed | cancelled
  status        String    @default("pending")
  // priority: low | normal | high | urgent
  priority      String    @default("normal")
  // type is trade-specific — values driven by brand.config.js jobTypes
  type          String    @default("residential")
  // tradeType mirrors BRAND_TRADE_TYPE for multi-trade platforms
  tradeType     String?
  scheduledAt   DateTime?
  scheduledDate String?
  scheduledTime String?
  duration      Float?    @default(1.5)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  customer      Customer  @relation(fields: [customerId], references: [id])
  customerId    Int
  technician    User?     @relation(fields: [technicianId], references: [id])
  technicianId  Int?
  quote         Quote?
  invoice       Invoice?
  jobParts      JobPart[]
  photos        JobPhoto[]
  notes         String?
  version       Int       @default(1)
  // Import provenance (see Customer.sourceSystem)
  sourceSystem  String?
  sourceId      String?

  @@unique([sourceSystem, sourceId])
}

// ─── Quote ────────────────────────────────────────────────────────────────────
// Money is Decimal(12,2); helpers/prisma.js maps Decimal fields to JS numbers on
// read, so the API keeps returning plain JSON numbers.
// `amount` is the document TOTAL (subtotal + taxTotal). With lines the server
// computes subtotal / taxTotal / amount (helpers/documents.js); without lines
// (legacy) subtotal = amount and taxTotal = 0.
model Quote {
  id            Int         @id @default(autoincrement())
  // Sequential per type, e.g. Q-0001 (prefix BRAND_QUOTE_PREFIX). The app
  // allocates it inside the create transaction; the DB default covers direct inserts.
  number        String      @unique @default(dbgenerated("mbc_next_document_number('quote'::text, NULL::text)"))
  jobId         Int         @unique
  job           Job         @relation(fields: [jobId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @db.Decimal(12, 2)
  // ISO 4217, snapshot of the brand currency when the quote was created
  currency      String      @default("USD")
  reverseCharge Boolean     @default(false)
  // status: draft | sent | approved | declined
  status        String      @default("draft")
  notes         String?
  issuedAt      DateTime    @default(now())
  // First time it was sent (email or status → sent). Locks the document.
  sentAt        DateTime?
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  lines         QuoteLine[]
}

// ─── QuoteLine / InvoiceLine ──────────────────────────────────────────────────
// lineTotal = round_half_up(quantity × unitPrice, 2). taxRate is a snapshot (%)
// of the configured rate for taxRateKey (BRAND_TAX_RATES) at the time of saving.
model QuoteLine {
  id              Int            @id @default(autoincrement())
  quoteId         Int
  quote           Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position        Int
  description     String
  quantity        Decimal        @db.Decimal(12, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  taxRateKey      String?
  taxRate         Decimal        @default(0) @db.Decimal(6, 3)
  lineTotal       Decimal        @db.Decimal(12, 2)
  pricebookItemId Int?
  pricebookItem   PriceBookItem? @relation(fields: [pricebookItemId], references: [id], onDelete: SetNull)

  @@unique([quoteId, position])
}

model InvoiceLine {
  id              Int            @id @default(autoincrement())
  invoiceId       Int
  invoice         Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  description     String
  quantity        Decimal        @db.Decimal(12, 3)
  unitPrice       Decimal        @db.Decimal(12, 2)
  taxRateKey      String?
  taxRate         Decimal        @default(0) @db.Decimal(6, 3)
  lineTotal       Decimal        @db.Decimal(12, 2)
  pricebookItemId Int?
  pricebookItem   PriceBookItem? @relation(fields: [pricebookItemId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
}

// ─── DocumentCounter ──────────────────────────────────────────────────────────
// One row per document type ('quote', 'invoice'); used only through the SQL
// function mbc_next_document_number(type, prefix) (migration 20261121140000).
model DocumentCounter {
  type   String @id
  prefix String
  next   Int    @default(1)
}

// ─── Invoice ──────────────────────────────────────────────────────────────────
// Same money / numbering rules as Quote (prefix BRAND_INVOICE_PREFIX, e.g. INV-0001).
model Invoice {
  id            Int           @id @default(autoincrement())
  number        String        @unique @default(dbgenerated("mbc_next_document_number('invoice'::text, NULL::text)"))
  jobId         Int           @unique
  job           Job           @relation(fields: [jobId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  currency      String        @default("USD")
  reverseCharge Boolean       @default(false)
  // status: unpaid | paid | overdue | void
  status        String        @default("unpaid")
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  issuedAt      DateTime      @default(now())
  sentAt        DateTime?
  version       Int           @default(1)
  createdAt     DateTime      @default(now())
  lines         InvoiceLine[]
}

// ─── InventoryItem ────────────────────────────────────────────────────────────
model InventoryItem {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  sku         String?   @unique
  quantity    Int       @default(0)
  minQuantity Int       @default(5)
  unitCost    Decimal   @db.Decimal(12, 2)
  category    String    @default("general")
  location    String?
  createdAt   DateTime  @default(now())
  jobParts    JobPart[]
}

// ─── JobPart ──────────────────────────────────────────────────────────────────
model JobPart {
  id              Int           @id @default(autoincrement())
  jobId           Int
  job             Job           @relation(fields: [jobId], references: [id])
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  unitCost        Decimal       @db.Decimal(12, 2)
}

// ─── PriceBookItem ────────────────────────────────────────────────────────────
// The `industry` field mirrors BRAND_INDUSTRY_LABEL / brand.config.js
model PriceBookItem {
  id          Int      @id @default(autoincrement())
  // industry: Electrical | Plumbing | HVAC | General Contracting
  industry    String   @default("Electrical")
  category    String
  subcategory String?
  name        String
  description String?
  price       Decimal  @default(0) @db.Decimal(12, 2)
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  taxable     Boolean  @default(false)
  // Key into BRAND_TAX_RATES (e.g. "standard", "reduced"); null = BRAND_TAX_DEFAULT
  taxRateKey  String?
  unit        String?
  taskCode    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  quoteLines   QuoteLine[]
  invoiceLines InvoiceLine[]
}

// ─── Communication ────────────────────────────────────────────────────────────
// Tracks all customer communications: calls, emails, texts, notes
model Communication {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  // type: call | email | text | note
  type       String
  // direction: inbound | outbound
  direction  String   @default("outbound")
  subject    String?
  body       String?
  from       String?
  to         String?
  gmailMsgId String?
  createdAt  DateTime @default(now())
}

// ─── ApiKey ──────────────────────────────────────────────────────────────────
// Per-company API keys for external integrations (QuickBooks, Twilio, Square…)
// Keys are hashed with bcrypt — the plaintext is shown only once at creation.
model ApiKey {
  id          Int       @id @default(autoincrement())
  // Human-readable label, e.g. "QuickBooks Sync", "Twilio", "Square POS"
  name        String
  // Unique prefix for lookup: first 8 chars of the key (e.g. "mbc_a1b2")
  prefix      String    @unique
  // bcrypt hash of the full key
  hashedKey   String
  // Scopes: comma-separated list, e.g. "read,write" or "read"
  scopes      String    @default("read,write")
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
}

// ─── JobPhoto ──────────────────────────────────────────────────────────────────
// Photos attached to a job, stored in S3-compatible object storage (MinIO in the
// local demo, Wasabi / S3 / Spaces in production). Only metadata + the object key
// are persisted in the database; the bytes live in the bucket.
model JobPhoto {
  id           Int      @id @default(autoincrement())
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId        Int
  // Object storage key, e.g. jobs/12/1718-abc123-pipe.jpg
  key          String
  originalName String?
  contentType  String?
  size         Int?
  // User id that uploaded the photo (no FK — kept simple, user may be deleted)
  uploadedById Int?
  createdAt    DateTime @default(now())
}

// ─── IntegrationToken ─────────────────────────────────────────────────────────
// OAuth tokens for third-party integrations (one row per provider, e.g.
// "quickbooks"). accessToken / refreshToken are encrypted at rest
// (helpers/secretBox.js, AES-256-GCM). Migration: 20261121120000_add_integration_tokens
model IntegrationToken {
  id               Int       @id @default(autoincrement())
  provider         String    @unique
  realmId          String?
  accessToken      String
  refreshToken     String
  tokenType        String?
  expiresAt        DateTime?
  refreshExpiresAt DateTime?
  // User id that connected the integration (no FK — user may be deleted)
  connectedById    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─── JobActivity ──────────────────────────────────────────────────────────────
// Append-only activity log per job (GTM-18). Written by helpers/activity.js in
// the same transaction as the change; read via GET /api/jobs/:id/activity and
// GET /api/activity. Migration: 20261121150000_job_activity.
// jobId has a database FK to Job.id with ON DELETE SET NULL (declared in the
// migration, deliberately not as a Prisma relation so the Job model is
// untouched); jobRef keeps the job id after the job is deleted (tombstones).
// actorUserId / actorApiKeyId have no FK so the row outlives the user / key.
// Append-only: no update/delete route. type ∈ helpers/activity.js TYPES (DB CHECK).
model JobActivity {
  id            Int      @id @default(autoincrement())
  jobId         Int?
  jobRef        Int
  actorUserId   Int?
  actorApiKeyId Int?
  type          String
  from          Json?
  to            Json?
  createdAt     DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([jobRef])
  @@index([createdAt])
}
