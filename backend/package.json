{
    "name": "modern-blue-collar-backend",
    "version": "2.0.0",
    "description": "White-label field service management backend — electrical, plumbing, HVAC, contracting",
    "main": "server.js",
    "scripts": {
        "start": "node scripts/migrate-deploy.mjs && node server.js",
        "dev": "nodemon server.js",
        "sandbox": "node scripts/sandbox.js",
        "sandbox:setup": "node scripts/sandbox.js --no-start",
        "build": "npm run generate && npm run migrate:deploy",
        "postinstall": "node scripts/prisma-generate.js",
        "generate": "node scripts/prisma-generate.js",
        "migrate": "npx prisma migrate dev",
        "migrate:deploy": "node scripts/migrate-deploy.mjs",
        "migrate:prod": "node scripts/migrate-deploy.mjs",
        "migrate:deploy:native": "npx prisma migrate deploy",
        "seed:admin": "node seed_superadmin.js",
        "seed:prices": "node seed_pricebook.js",
        "seed:jobs": "node seed_jobs.js",
        "seed:apikey": "node seed_apikey.js",
        "seed:all": "node seed_superadmin.js && node seed_pricebook.js && node seed_jobs.js",
        "test": "node tests/api.test.js",
        "studio": "npx prisma studio",
        "test:platform": "node --test tests/platform.test.js",
        "test:redteam": "node --test --test-concurrency=1 tests/redteam.test.js",
        "test:ui": "node tests/ui/walk.js",
        "test:backend": "node --test --test-concurrency=1 tests/backend.test.js",
        "seed:demo": "node scripts/seed-demo.js",
        "demo:check": "node scripts/demo-check.js",
        "test:whitelabel": "node --test --test-concurrency=1 tests/whitelabel.test.js",
        "test:activity": "node --test --test-concurrency=1 tests/activity.test.js",
        "test:documents": "node --test --test-concurrency=1 tests/documents.test.js",
        "backup:run": "node scripts/backup-run.js",
        "restore": "node scripts/restore.mjs",
        "test:integrations": "node --test --test-concurrency=1 tests/integrations.test.js",
        "test:accounts": "node --test --test-concurrency=1 tests/accounts.test.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1024.0",
        "@prisma/adapter-pg": "7.10.1",
        "@prisma/client": "7.10.1",
        "@prisma/driver-adapter-utils": "7.10.1",
        "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.3.1",
        "express-validator": "^7.0.1",
        "fflate": "^0.8.3",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.0",
        "multer": "^2.5.0",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.6.1",
        "passport": "^0.6.0",
        "passport-google-oauth20": "^2.0.0",
        "pg": "^8.16.3",
        "prisma": "7.10.1",
        "socket.io": "^4.8.3",
        "twilio": "^4.19.3"
    },
    "devDependencies": {
        "nodemon": "^3.0.2",
        "puppeteer-core": "^25.18.1"
    },
    "engines": {
        "node": "^20.19 || ^22.12 || >=24.0"
    },
    "license": "MIT",
    "overrides": {
        "qs": "^6.16.2",
        "effect": "^3.22.5"
    }
}
