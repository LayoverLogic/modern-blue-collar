# =============================================================================
# Modern Blue Collar — SANDBOX environment (zero paid services, no Docker)
#
#   cd backend
#   npm install
#   npm run sandbox          # copies this file to .env.sandbox on first run,
#                            # creates the DB if missing, migrates, seeds, starts
#
# Needs only Node 20.19+/22.12+ and a local PostgreSQL you can log in to.
# Nothing here talks to the internet: files go to local disk, email goes to an
# outbox folder, backups go to a local folder, Twilio / QuickBooks / Google are
# inert. All values below are throwaway sandbox values — never real secrets.
#
# Real process env always wins over this file, e.g.
#   PORT=3150 DATABASE_URL=postgresql://.../mbc_other npm run sandbox
# =============================================================================

# ─── Mode switches ───────────────────────────────────────────────────────────
# SANDBOX_MODE: every third-party integration is disabled (503 "disabled in
# sandbox"; SMS is logged, not sent). DEMO_MODE: seed demo data + demo UI hints.
SANDBOX_MODE=true
DEMO_MODE=true

# ─── Database (local Postgres) ───────────────────────────────────────────────
# `npm run sandbox` creates this database if it does not exist (the role needs
# CREATEDB, or create it yourself first).
DATABASE_URL=postgresql://mbc:mbc_sandbox@localhost:5432/mbc_sandbox?schema=public

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3101
# Links in emails. `npm run sandbox` keeps a localhost APP_URL in step with PORT
# (PORT=3150 npm run sandbox → http://localhost:3150); a non-local URL (e.g. a
# tunnel) or an APP_URL set in your shell is used as is.
APP_URL=http://localhost:3101
# `npm run sandbox` listens on 127.0.0.1 only. HOST=0.0.0.0 shares it on your
# network — only on one you trust (demo mode shows the demo login).
# HOST=127.0.0.1
NODE_ENV=development
# Placeholder: `npm run sandbox` replaces it with a random secret in the env
# file it uses (backend/.env.sandbox, or your ENV_FILE) on first run. The server
# refuses this value (and other published ones) unless SANDBOX_MODE=true, where
# it runs on a random per-process secret instead. Never commit a real value here.
JWT_SECRET=__GENERATE_ON_FIRST_RUN__
JWT_EXPIRES=8h

# Seeded demo admin (seed_superadmin.js) and password for seeded team members
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD=demo1234
ADMIN_FIRST=Demo
ADMIN_LAST=Admin
DEFAULT_PASSWORD=demo1234

# ─── Storage: local disk instead of S3 / MinIO ───────────────────────────────
STORAGE_DRIVER=local
# Default: backend/storage (gitignored)
LOCAL_STORAGE_DIR=

# ─── Email: write .eml + .json files instead of sending ──────────────────────
MAIL_DRIVER=outbox
# Default: backend/outbox (gitignored)
MAIL_OUTBOX_DIR=
SMTP_FROM=no-reply@demo.test

# ─── Backups: pg_dump to a local folder, no upload ───────────────────────────
BACKUP_DRIVER=local
# Default: backend/backups (gitignored). pg_dump must be on PATH (PG_DUMP_PATH overrides).
BACKUP_DIR=
BACKUP_KEEP=30
BACKUP_KEEP_UPLOADS=3
# Optional even in the sandbox (no network needed): encrypt local backups.
BACKUP_ENCRYPTION_KEY=
# Off-site upload settings (BACKUP_DRIVER=s3 only; unused in the sandbox). The
# legacy WASABI_* names are still read as a fallback — use these instead.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=backups/
BACKUP_S3_FORCE_PATH_STYLE=true
BACKUP_S3_MULTIPART_MB=100
# Heartbeat pings make a network call — leave blank in the sandbox.
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=

# ─── Technician visibility (helpers/access.js) ────────────────────────────────
# own (default): technicians see only their own jobs and those jobs' customers.
# all: technicians can READ the whole schedule, every job and customer (not
#      quotes / invoices / communications of other people's jobs); they still
#      only WRITE status / notes / photos on their own jobs.
TECH_VISIBILITY=own

# ─── Branding / white-label (see brand.config.js, SETUP.md "White-label") ─────
# Env-only: switching client or trade never needs a source edit. Invalid values
# (unknown trade, bad colour, bad URL, unknown time zone) stop the server at
# boot with a message naming the variable.
BRAND_COMPANY_NAME=Modern Blue Collar
BRAND_COMPANY_SLOGAN=Field Service Management
BRAND_COMPANY_PHONE=
BRAND_COMPANY_EMAIL=
BRAND_COMPANY_ADDRESS=
# electrical | plumbing | hvac | plumbing-hvac | contracting  (case-insensitive;
# "Plumbing & HVAC", "HVAC", "General Contracting" are accepted too)
BRAND_TRADE_TYPE=plumbing-hvac
# Labels — blank = derived from the trade (Electrician / Plumber / HVAC Technician ...)
BRAND_TECH_LABEL=
BRAND_INDUSTRY_LABEL=
# Colours: hex, quoted so # is not a comment. Blank = the trade's palette
# (electrical yellow, plumbing blue, hvac teal, plumbing-hvac blue, contracting
# orange). PRIMARY_DARK (hover/active) and readable text colours are derived from
# PRIMARY / NAV_BG / HEADER_BG unless set.
BRAND_COLOR_PRIMARY=
BRAND_COLOR_PRIMARY_DARK=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
BRAND_COLOR_NAV_BG=
BRAND_COLOR_NAV_TEXT=
BRAND_COLOR_HEADER_BG=
BRAND_COLOR_HEADER_TEXT=
# Logo / favicon: https:// URL, a same-origin path (/brand/logo.svg) or a
# data:image/...;base64 URL. Favicon defaults to the logo.
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
# Default state for US address forms; IANA time zone for dates, "today", backups
BRAND_DEFAULT_STATE=KS
BRAND_TIMEZONE=America/Chicago
# ─── Locale (helpers/locale.js) ───────────────────────────────────────────────
# US (default) | IE. Sets currency, tax, address rules, phone normalisation
# (customer / user phones are stored as E.164, e.g. +16205550142) and the
# first day of the week (US sunday, IE monday). Uncomment to override a default;
# an EMPTY BRAND_TAX_RATES / BRAND_*_PREFIX means "none", so leave them commented.
BRAND_COUNTRY=
# Job types offered on jobs (comma list, ≤ 40, validated at boot). Unset = the
# trade's list in the BRAND_COUNTRY wording (IE: Boiler Service, Consumer Unit Upgrade…).
# BRAND_JOB_TYPES=Boiler Service,Boiler Repair,Leak Repair,Other
# BRAND_CURRENCY=EUR
# BRAND_TAX_RATES=standard:23,reduced:13.5,zero:0
# BRAND_TAX_DEFAULT=reduced
# BRAND_TAX_LABEL=VAT
# BRAND_TAX_NUMBER=
# BRAND_QUOTE_PREFIX=Q-
# BRAND_INVOICE_PREFIX=INV-
# BRAND_RCT_NOTE=
# Demo data prospect: backend/demo/prospects/<slug>.json (blank = "default",
# a generic Anytown demo for whatever BRAND_TRADE_TYPE is). Per-prospect env file:
#   node scripts/seed-demo.js --prospect ks-plumbing-example --print-env
DEMO_PROSPECT=

# ─── Integrations: placeholders only — inert in the sandbox ──────────────────
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE_NUMBER=placeholder
QB_CLIENT_ID=placeholder
QB_CLIENT_SECRET=placeholder
QB_REDIRECT_URI=placeholder
QB_ENVIRONMENT=sandbox
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=placeholder
GOOGLE_MAPS_API_KEY=

# ─── Accounts & sign-in (Phase 2d / B3) ──────────────────────────────────────
# Only FAILED sign-ins count, per IP + email and per IP (in memory, 15 min).
# LOGIN_MAX_PER_EMAIL=10
# LOGIN_MAX_PER_IP=50
# Forgot / reset / invite-link requests per IP per 15 min
# RESET_RATE_MAX=20
# PASSWORD_MIN_LENGTH=10           (never below 8)
# RESET_TOKEN_TTL_MINUTES=30       forgot-password / admin reset links
# INVITE_TTL_HOURS=168             accept-invite links
# seed_superadmin: a generated password is always temporary; force it for ADMIN_PASSWORD too
# ADMIN_FORCE_PASSWORD_CHANGE=false
