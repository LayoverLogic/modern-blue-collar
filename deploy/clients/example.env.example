# =============================================================================
# Per-client settings for deploy/provision.sh — ONE FILE PER CLIENT.
#
#   1. cp deploy/clients/example.env.example deploy/clients/<slug>.env
#      (on the server; <slug>.env is gitignored — never commit it)
#   2. Fill in every CHANGE_ME (provision.sh refuses to run while any remain).
#   3. sudo deploy/provision.sh deploy/clients/<slug>.env
#
# provision.sh writes the repo-root .env from this file plus:
#   - forced production values: NODE_ENV=production, DEMO_MODE=false,
#     SANDBOX_MODE=false, PORT=3001, TRUST_PROXY=1, APP_URL=https://APP_DOMAIN
#   - generated secrets (first run only; re-runs keep them): JWT_SECRET,
#     POSTGRES_PASSWORD, INTEGRATION_ENCRYPTION_KEY, BACKUP_ENCRYPTION_KEY
# Values are read literally (this file is never executed). Quote values that
# contain spaces or '#', e.g. BRAND_COLOR_PRIMARY="#1565c0".
# =============================================================================

# ─── Instance ────────────────────────────────────────────────────────────────
# Short slug, lowercase letters/digits/hyphens (used in names and messages)
CLIENT_SLUG=CHANGE_ME
# Public host name; its DNS A (and AAAA) record must point at this server
APP_DOMAIN=CHANGE_ME
# Let's Encrypt account e-mail (certificate expiry warnings)
ACME_EMAIL=CHANGE_ME
# Where uploads/ and backups/ live on the host (default /opt/mbc/data)
MBC_DATA_DIR=/opt/mbc/data

# ─── First owner account (docker compose exec app node seed_superadmin.js) ──
# Leave ADMIN_PASSWORD blank: seed_superadmin.js then generates one and prints
# it ONCE, so no password ever sits in .env.
ADMIN_EMAIL=CHANGE_ME
ADMIN_FIRST=CHANGE_ME
ADMIN_LAST=CHANGE_ME
ADMIN_PASSWORD=
JWT_EXPIRES=8h

# ─── Branding / white-label (see SETUP.md "White-label") ─────────────────────
BRAND_COMPANY_NAME=CHANGE_ME
BRAND_COMPANY_SLOGAN=
BRAND_COMPANY_PHONE=
BRAND_COMPANY_EMAIL=
BRAND_COMPANY_ADDRESS=
# electrical | plumbing | hvac | plumbing-hvac | contracting
BRAND_TRADE_TYPE=CHANGE_ME
BRAND_TECH_LABEL=
BRAND_INDUSTRY_LABEL=
BRAND_COLOR_PRIMARY=
BRAND_COLOR_SECONDARY=
BRAND_COLOR_ACCENT=
BRAND_COLOR_NAV_BG=
BRAND_COLOR_NAV_TEXT=
BRAND_COLOR_HEADER_BG=
BRAND_COLOR_HEADER_TEXT=
BRAND_LOGO_URL=
BRAND_FAVICON_URL=
BRAND_DEFAULT_STATE=KS
# IANA zone: America/Chicago (Kansas), Europe/Dublin (Ireland). Also sets the
# 03:00 nightly backup time.
BRAND_TIMEZONE=CHANGE_ME

# ─── Job photos ──────────────────────────────────────────────────────────────
# local → files under MBC_DATA_DIR/uploads, included in every backup set.
# s3    → an S3-compatible bucket (Cloudflare R2 / Backblaze B2 / AWS S3).
STORAGE_DRIVER=local
# Only for STORAGE_DRIVER=s3 — a PHOTOS bucket, never the backup bucket.
#   R2 (US):  https://<ACCOUNT_ID>.r2.cloudflarestorage.com      region auto
#   R2 (EU):  https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com   region auto
#   B2:       https://s3.<region>.backblazeb2.com                region e.g. eu-central-003
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Mail (team invites, sign-in links) ──────────────────────────────────────
# e.g. Amazon SES email-smtp.eu-west-1.amazonaws.com (Irish clients) or
# smtp.postmarkapp.com; port 587
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=CHANGE_ME

# ─── Off-site backups (separate bucket + separate token from photos) ────────
# Every night at 03:00 BRAND_TIMEZONE: pg_dump + (local) photos, encrypted with
# BACKUP_ENCRYPTION_KEY, uploaded under BACKUP_S3_PREFIX. A failed upload is a
# failed backup. Retention = a lifecycle rule on the bucket (DEPLOYMENT.md).
BACKUP_DRIVER=s3
BACKUP_S3_ENDPOINT=CHANGE_ME
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=CHANGE_ME
BACKUP_S3_ACCESS_KEY=CHANGE_ME
BACKUP_S3_SECRET_KEY=CHANGE_ME
BACKUP_S3_PREFIX=backups/
# Local copies kept on the server (sets / sets that keep their photo archive)
BACKUP_KEEP=14
BACKUP_KEEP_UPLOADS=3
# Healthchecks.io ping URL (https://hc-ping.com/<uuid>): pinged after every
# successful backup; failures go to <url>/fail automatically. For other
# services set BACKUP_HEARTBEAT_FAIL_URL as well (or leave it blank).
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=

# ─── Integrations (leave blank unless in scope for this client) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_ALLOWED_DOMAINS=
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=
QB_ENVIRONMENT=production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_MAPS_API_KEY=

# ─── Secrets: LEAVE BLANK on a new server (provision.sh generates them) ──────
# Fill these in only when REBUILDING a client's server (disaster recovery or a
# move): paste the values from the password manager so the restored database,
# the QuickBooks tokens and the encrypted backups stay readable.
JWT_SECRET=
POSTGRES_PASSWORD=
INTEGRATION_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
